# =============================================================================
# ZStyle Services - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values
# =============================================================================

# Application
PORT=8000 (as is)
ENV=development (as is)

# Database (PostgreSQL - Local Docker Container)
# Connection string uses Docker service name 'db' for internal DNS resolution
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=zstyle_db
DATABASE_URL=postgresql://postgres:your_secure_password_here@db:5432/zstyle_db

# Google / Gemini API
GOOGLE_API_KEY=google-api-key
GOOGLE_GENAI_USE_VERTEXAI=False (as is)

# OpenMemory (Embedding Service)
OPENMEMORY_URL=http://openmemory:8080 (as is)
OPENMEMORY_API_KEY=your_openmemory_api_key (as is)
OM_TIER=hybrid

# Security
SECRET_KEY=your_secret_key_minimum_32_characters_long (as is)

# OAuth (Optional)

OAUTH_BASE_URL=https://127.0.0.1.com (as is)

# Google OAuth
GOOGLE_CLIENT_ID=the-client-id
GOOGLE_CLIENT_SECRET=the-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/oauth/google/callback (as is)

TICKTICK_CLIENT_ID=the-client-id
TICKTICK_CLIENT_SECRET=the-client-secret
TICKTICK_REDIRECT_URI=the-uri

# Telegram
TELEGRAM_BOT_TOKEN=the-token
TELEGRAM_API_ID=the-id
TELEGRAM_API_HASH=the-hash-token
TELEGRAM_SESSION_STRING=the-string-is-here

# Telegram Webhook (Optional - leave empty for polling)
TELEGRAM_WEBHOOK_URL=https://your-domain.com/webhook/telegram
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret