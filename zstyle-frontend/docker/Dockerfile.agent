# Dockerfile for Python LangGraph Agent
FROM python:3.12-slim

WORKDIR /app

# Install system dependencies and uv
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && curl -LsSf https://astral.sh/uv/install.sh | sh \
    && rm -rf /var/lib/apt/lists/*

# Make uv available in PATH
ENV PATH="/root/.local/bin:$PATH"

# Copy project files
COPY apps/agent/pyproject.toml ./apps/agent/
COPY apps/agent/uv.lock ./apps/agent/ 2>/dev/null || true

WORKDIR /app/apps/agent

# Install dependencies with uv
RUN uv sync --frozen

# Install LangGraph CLI globally
RUN /root/.local/bin/uv pip install langgraph-cli

# Copy the rest of the application
COPY apps/agent .

# Set environment variables
ENV PYTHONUNBUFFERED=1
EXPOSE 8123

# Run LangGraph dev server
CMD ["/root/.local/bin/uv", "run", "langgraph", "dev", "--port", "8123", "--host", "0.0.0.0", "--no-browser"]
