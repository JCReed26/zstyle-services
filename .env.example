# Required: Google API key (used by agent for Gemini LLM + OpenMemory for embeddings)
GOOGLE_API_KEY=

# Optional: Override the default Gemini model (default: gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash

# Optional: LangSmith for tracing (used by agent)
LANGSMITH_API_KEY=

# Docker service URLs (auto-configured in docker-compose.yml)
# LANGGRAPH_DEPLOYMENT_URL=http://agent:8123
# MCP_SERVER_URL=http://mcp-threejs:3108/mcp
# OPENMEMORY_MCP_URL=http://memory:8080/mcp
